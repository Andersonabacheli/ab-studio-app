# Copie este arquivo para ".env" e preencha com os valores reais do seu projeto.
# NUNCA versione o arquivo ".env" (ele já está no .gitignore).
#
# Encontre esses valores em: Supabase Dashboard > Project Settings > API

# URL do projeto Supabase (ex: https://xxxxx.supabase.co)
VITE_SUPABASE_URL=

# "anon public key" — segura para uso no frontend, DESDE QUE o RLS
# esteja ativo em todas as tabelas (ver Etapa 1 do projeto).
VITE_SUPABASE_ANON_KEY=

# Endpoint usado pelo formulário de contato (pode ser uma Edge Function
# do Supabase ou uma rota própria). Deixe vazio por enquanto — configuramos
# na Etapa 4.
VITE_CONTACT_API_URL=
